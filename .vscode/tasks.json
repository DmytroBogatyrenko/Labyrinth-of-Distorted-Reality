{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-labyrinth-sfml",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "main.cpp",
        "-o",
        "labyrinth.exe",
        "-IC:/SFML-3.0.2/include",
        "-LC:/SFML-3.0.2/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}